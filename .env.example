# ===== Telegram bot =====
# @BotFather dan olingan token (majburiy)
BOT_TOKEN=123456:ABC-DEF...

# Admin Telegram ID'lar (vergul bilan ajrating) — ular "owner" hisoblanadi
ADMIN_IDS=5425876649

# Kinolar saqlanadigan MAXFIY baza kanal ID'si (bot u yerda admin bo'lishi shart)
BASE_CHANNEL_ID=-1001234567890

# Kino kanali (promo/trailer postlar shu yerga yuboriladi) — ixtiyoriy
MOVIE_CHANNEL_ID=-1001234567890

# To'lov cheklari (screenshot) audit kanali — ixtiyoriy
PAYMENT_CHANNEL_ID=-1001234567890

# Premium custom emoji'larni yoqish/o'chirish (true/false)
USE_PREMIUM_EMOJI=true

# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://user:password@localhost:5432/kinobot?schema=public"

# ===== AI provayder kalitlari (ixtiyoriy — qaysi biri bo'lsa o'sha ishlaydi) =====
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
MISTRAL_API_KEY=

# ===== Webhook rejimi (standart: polling). Faqat server/webhook uchun =====
# USE_WEBHOOK=true bo'lsa yoki WEBHOOK_URL berilsa webhook rejim ishga tushadi.
USE_WEBHOOK=false
WEBHOOK_URL=https://example.com/webhook
# WEBHOOK_SECRET — webhook rejimida MAJBURIY (bashorat qilib bo'lmaydigan qiymat bering)
WEBHOOK_SECRET=
# Webhook server porti
PORT=8080
# Keep-alive pingni o'chirish (true bo'lsa ping yuborilmaydi)
DISABLE_KEEPALIVE=false

# ===== Bot sozlamalari =====
# Admin tugmasidagi kontakt havolasi (keyboard.ts ADMIN_CONTACT_URL o'rniga)
ADMIN_CONTACT_URL=https://t.me/your_admin
