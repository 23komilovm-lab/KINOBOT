// Prisma schema — Kino bot
// DB: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== FOYDALANUVCHILAR =====================
model User {
  id                BigInt   @id
  firstName         String?
  username          String?
  region            String?
  gender            String?  // "Erkak"/"Ayol" — foydalanuvchi so'rovnomada o'zi tanlagan (taxmin emas)
  referredById      BigInt?  // kim taklif qilgan
  referralConfirmed Boolean  @default(false) // obunadan keyin tasdiqlanadi
  isBlocked         Boolean  @default(false)
  isAdmin           Boolean  @default(false)
  permissions       String?  // ruxsat etilgan bo'limlar (vergul bilan); null = hammasi
  channelLimit      Int?     // majburiy obunaga qo'sha oladigan max kanal; null = cheksiz
  premiumUntil      DateTime? // premium tugash vaqti (null/o'tgan = premium emas)
  premiumWarnStage  Int      @default(0)  // 0=yo'q · 1=3 kun qoldi · 2=1 kun qoldi · 3=tugadi (premium berilganda 0 ga qaytadi)
  requestCount      Int      @default(0)  // bepul kino so'rovlari hisobi
  firstRequestAt    DateTime? // birinchi so'rov vaqti (vaqt cheklovi uchun)
  aiRequestCount    Int      @default(0)  // bugungi AI so'rovlari hisobi
  aiRequestDay      String?  // "YYYY-MM-DD" — kun o'zgarsa aiRequestCount reset
  contentRequestDay      String? // "YYYY-MM-DD" (Toshkent) — kunlik kontent limiti kuni
  contentRequestCount    Int      @default(0) // joriy kundagi kontent so'rovlari
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([referredById])
  @@index([premiumUntil])
  @@index([aiRequestDay])
  @@map("users")
}

// ===================== PREMIUM TARIFLAR =====================
model Tariff {
  id         Int     @id @default(autoincrement())
  label      String  // masalan "1 oy"
  days       Int     // premium davomiyligi (kun)
  price      Int     // hozirgi (chegirmali) narx (so'm)
  oldPrice   Int?    // eski narx — ustidan chizilgan holda ko'rsatiladi (null = ko'rsatilmaydi)
  starsPrice Int?    // Telegram Stars narxi (null = Stars orqali sotib olib bo'lmaydi)
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  @@map("tariffs")
}

// ===================== PREMIUM TO'LOVLARI (qo'lda tasdiq) =====================
model Payment {
  id           Int       @id @default(autoincrement())
  userId       BigInt
  tariffId     Int
  tariffLabel  String    // snapshot (tarif o'zgarsa tarix buzilmasin)
  days         Int       // snapshot
  amount       Int       // snapshot
  method       String    @default("karta") // karta | ton | stars
  status       String    @default("pending") // pending | approved | rejected
  proofFileId  String?   // chek/screenshot file_id
  // Bildirishnoma yuborilgan joylar (ownerlar + audit kanali) — JSON:
  // [{"c":chatId,"m":messageId}]. Tasdiqlash/rad etishda HAMMASI yangilanadi,
  // aks holda kanaldagi nusxa "kutilmoqda" holatida qolib ketardi.
  notifyRefs   String?
  createdAt    DateTime  @default(now())
  reviewedById BigInt?
  reviewedAt   DateTime?

  @@index([status])
  @@index([userId])
  @@map("payments")
}

// ===================== FUNNEL (SO'ROVNOMA) =====================
model Survey {
  id             Int      @id @default(autoincrement())
  title          String
  question       String
  isRegionSurvey Boolean  @default(false)
  isGenderSurvey Boolean  @default(false)
  nextSurveyId   Int?     // javob berilgach avtomatik yuboriladigan keyingi so'rovnoma (zanjir)
  sentCount      Int      @default(0)
  createdAt      DateTime @default(now())

  options   SurveyOption[]
  responses SurveyResponse[]

  @@map("surveys")
}

model SurveyOption {
  id        Int    @id @default(autoincrement())
  surveyId  Int
  text      String
  sortOrder Int    @default(0)

  survey    Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@map("survey_options")
}

model SurveyResponse {
  id       Int      @id @default(autoincrement())
  surveyId Int
  optionId Int
  userId   BigInt
  date     DateTime @default(now())

  survey Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  option SurveyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@map("survey_responses")
}

// ===================== SERIAL KO'RISH PROGRESSI =====================
// Har bir foydalanuvchi-serial juftligi uchun oxirgi ko'rilgan qism.
// "Davom etish" tugmasi shu yozuv asosida keyingi qismni ochadi.
model SerialWatch {
  userId    BigInt
  serialId  Int
  episodeId Int
  updatedAt DateTime @updatedAt

  serial Serial @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@id([userId, serialId])
  @@map("serial_watch")
}

// ===================== KO'RISH HODISALARI (tavsiya signali) =====================
// Har bir muvaffaqiyatli yetkazilgan kino/serial qismi uchun yoziladi.
// Janr affiniteti (recommend) shu jadval asosida hisoblanadi.
model WatchEvent {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  movieId   Int?
  serialId  Int?
  genre     String?
  createdAt DateTime @default(now())

  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: SetNull)
  serial Serial? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([genre])
  @@map("watch_events")
}

// ===================== BROADCAST TARIXI =====================
model Broadcast {
  id           Int      @id @default(autoincrement())
  targetType   String   @default("all")
  targetExtra  String?
  sentCount    Int      @default(0)
  failCount    Int      @default(0)  // vaqtinchalik xato (qayta yuborsa bo'ladi)
  blockedCount Int      @default(0)  // bloklagan/o'chirgan — qayta yuborish foydasiz
  abortReason  String?               // to'xtatilgan bo'lsa sababi

  // Qayta yuborish uchun shablon va xato bo'lganlar ro'yxati
  templateChatId BigInt?
  templateMsgId  Int?
  buttonsJson    String?             // inline knopkalar (JSON)
  failedIds      String?             // vaqtinchalik xato bo'lgan user id'lar (JSON, max 500)

  createdAt   DateTime @default(now())
  // Broadcast restart-safe: status/progress tiklanish uchun DB'da saqlanadi.
  // running | completed | aborted | interrupted
  status      String   @default("completed")
  total       Int      @default(0)  // jami yuboriladigan userlar soni
  processed   Int      @default(0)  // ishlanganlar soni
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("broadcasts")
}

// ===================== MAJBURIY OBUNA KANALLARI =====================
enum ChannelType {
  PUBLIC    // Ommaviy — @username bor
  PRIVATE   // Maxfiy — havola orqali
  REQUEST   // So'rovli — apply to join
  INSTAGRAM // Instagram profil — API tekshiruvi yo'q
}

model Channel {
  id          Int         @id @default(autoincrement())
  chatId      BigInt      @unique // Telegram chat id (-100...) yoki 0 Instagram uchun
  title       String
  username    String?
  inviteLink  String?     // PRIVATE/REQUEST uchun havola; INSTAGRAM uchun profil URL
  botInviteLink String?   // Bot tracking havolasi (createChatInviteLink name="bot_tracking")
  // Admin O'ZI yaratgan havola ("📎 Havolani ulash" orqali). Darvoza tugmasi
  // ENG BIRINCHI shuni beradi — egasi havolani o'z nazoratida ushlab, qo'shilish
  // sonini Telegram'ning o'z statistikasida ko'rishi uchun.
  //
  // `inviteLink` dan ALOHIDA saqlanadi: u yerda bot yaratgan zaxira havolalar
  // ham turadi (PRIVATE/REQUEST kanallarda), ikkalasini aralashtirsak boshqa
  // kanallarning atributsiyasi buzilardi. Kanal qayta qo'shilganda ham
  // `finishAddChannel` bu maydonga tegmaydi — havola yo'qolmaydi.
  adminInviteLink String?
  type        ChannelType @default(PUBLIC)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  buttonLabel String?     // Obuna sahifasida ko'rsatiladigan maxsus yorliq
  createdAt   DateTime    @default(now())

  // DIQQAT: tarix jadvallariga (join_requests / channel_members /
  // channel_invite_links / channel_events) ATAYLAB relatsiya yo'q.
  //
  // Ilgari ular `onDelete: Cascade` bilan bog'langan edi: kanal paneldan
  // o'chirilsa zayifkalar, a'zolik snapshoti va havolalar registri ham
  // o'chib ketardi, `channel_events` esa (FK'siz) tirik qolardi. Natijada
  // kanal uzib-ulanganda statistika yolg'on ko'rsatardi — 13.08.2026 da
  // "Русский язык" kanalida aynan shu bo'ldi: tarixda 832 odam, snapshotda 8.
  //
  // Endi hamma tarix `chatId` bo'yicha bog'lanadi va kanal o'chirilganda
  // saqlanib qoladi — o'sha chatId qayta qo'shilsa avtomatik ulanadi.

  @@map("channels")
}

// ===================== TAKLIF HAVOLALARI TARIXI =====================
// Bot yaratgan HAR BIR tracking havolasi shu yerda qoladi — havola yangilansa
// eskisi o'chirilmaydi, `isCurrent=false` + `revokedAt` bilan belgilanadi.
// Shu tufayli "eski havola orqali qancha, yangisi orqali qancha" ajratib
// ko'rsatiladi (`channel_events.inviteLink` bo'yicha guruhlash).
model ChannelInviteLink {
  id        Int       @id @default(autoincrement())
  channelId BigInt
  link      String    @unique
  seq       Int       @default(1) // kanal ichidagi tartib raqami: #1, #2, ...
  name      String? // "bot_tracking" | "majburiy_obuna"
  createdAt DateTime  @default(now())
  revokedAt DateTime? // bekor qilingan vaqt (null = tirik)
  isCurrent Boolean   @default(false) // shu turdagi (name) joriy havola

  @@index([channelId, seq])
  @@map("channel_invite_links")
}

// ===================== QO'SHILISH SO'ROVLARI (REQUEST kanallari) =====================
model JoinRequest {
  id         Int      @id @default(autoincrement())
  channelId  BigInt
  userId     BigInt
  firstName  String?
  username   String?
  status     String   @default("pending") // pending | approved | declined
  inviteLink String? // zayifka QAYSI havola orqali kelgan (ChatJoinRequest.invite_link)
  date       DateTime @default(now())

  @@unique([channelId, userId])
  @@index([channelId, date])
  @@index([channelId, inviteLink])
  @@index([userId])
  @@map("join_requests")
}

// ===================== KANAL QO'SHILISH/CHIQISH HODISALARI (statistika) =====================
model ChannelEvent {
  id         Int      @id @default(autoincrement())
  channelId  BigInt
  userId     BigInt
  type       String   @default("join") // join | leave
  source     String?  @default("unknown") // "bot" | "organic" | "unknown"
  inviteLink String? // qo'shilishda ishlatilgan taklif havolasi (bo'lsa) — havola kesimi uchun
  date       DateTime @default(now())

  @@index([channelId, date])
  @@index([date])
  @@index([channelId, source]) // bot/organic statistika uchun
  @@index([channelId, inviteLink]) // havola kesimi uchun
  @@map("channel_events")
}

// ===================== KANAL A'ZOLIGI SNAPSHOTI (joriy holat) =====================
// channel_events — to'liq voqealar jurnali (append-only). Bu jadval esa har bir
// (kanal, foydalanuvchi) uchun JORIY a'zolik faktini saqlaydi:
//  · bitta qator, @@unique — dublikat qo'shilishni yuqotuvchi serializatsiya nuqtasi
//  · source "bot" dan pastga TUSHIRILMAYDI (bir marta bot = doim bot)
//  · leftAt NULL = hozir a'zo (chiqishda yoziladi)
model ChannelMember {
  id         Int       @id @default(autoincrement())
  channelId  BigInt
  userId     BigInt
  joinedAt   DateTime  @default(now())
  source     String    @default("unknown")
  inviteLink String? // oxirgi ma'lum taklif havolasi (null ustidan yozilmaydi)
  leftAt     DateTime?

  @@unique([channelId, userId])
  @@index([channelId, source, joinedAt])
  @@index([channelId, inviteLink])
  @@map("channel_members")
}

// ===================== MANBA KANALLAR (avto-indekslash) =====================
model SourceChannel {
  id      Int      @id @default(autoincrement())
  chatId  BigInt   @unique
  title   String
  addedAt DateTime @default(now())

  @@map("source_channels")
}

// ===================== AI SARF-HISOBI (kunlik, provayder+model bo'yicha) =====================
model AiUsage {
  id       Int      @id @default(autoincrement())
  provider String
  model    String
  day      String   // "YYYY-MM-DD" — Toshkent vaqti (UTC+5), todayUz() bilan yoziladi
  requests Int      @default(0)
  tokens   Int      @default(0)

  @@unique([provider, model, day])
  @@map("ai_usage")
}

// ===================== KINO =====================
model Movie {
  id          Int      @id @default(autoincrement())
  code        Int      @unique
  title       String
  titleNorm   String   @default("") // normalizeTitle(title) — lotin, kichik, tinishsiz (aqlli qidiruv)
  caption     String?
  fileId      String
  baseMsgId   Int?
  year        Int?
  genre       String?
  quality     String?
  language    String?
  duration    Int?     // sekundlarda
  shortFileId String?  // qisqa (treyler) video file_id
  shortMsgId  Int?     // kino kanaldagi qisqa video xabar id
  isPremium   Boolean  @default(false) // faqat premium obunachilar ko'radi
  buttonText  String?
  buttonUrl   String?
  buttonStyle String   @default("primary")
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watchEvents WatchEvent[]

  @@index([title])
  @@index([genre])
  @@index([views])
  @@map("movies")
}

// ===================== SERIAL =====================
model Serial {
  id          Int      @id @default(autoincrement())
  code        Int      @unique
  title       String
  titleNorm   String   @default("") // normalizeTitle(title) — lotin, kichik, tinishsiz (aqqli qidiruv)
  caption     String?
  posterId    String?
  year        Int?
  genre       String?
  isPremium   Boolean  @default(false) // faqat premium obunachilar ko'radi
  buttonText  String?
  buttonUrl   String?
  buttonStyle String   @default("primary")
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seasons     Season[]
  watches     SerialWatch[]
  watchEvents WatchEvent[]

  @@index([title])
  @@index([genre])
  @@index([views])
  @@map("serials")
}

model Season {
  id       Int     @id @default(autoincrement())
  serialId Int
  number   Int
  title    String?

  serial   Serial    @relation(fields: [serialId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([serialId, number])
  @@map("seasons")
}

model Episode {
  id        Int      @id @default(autoincrement())
  seasonId  Int
  number    Int
  title     String?
  fileId    String
  baseMsgId Int?
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, number])
  @@map("episodes")
}

// ===================== SESSIYA (grammY) =====================
// Faqat bo'sh bo'lmagan sessiyalar saqlanadi — admin yarim tayyorlagan
// broadcast/qo'shish oqimi redeploy'dan keyin ham yo'qolmasin.
model Session {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// ===================== SOZLAMALAR =====================
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
